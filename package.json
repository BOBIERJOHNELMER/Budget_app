{
  "name": "SalaryWise",
  "version": "1.0.0",
  "displayName": "SalaryWise",
  "description": "Salary budgeting app with grocery simulation and receipt tracking.",
  "main": "index.js",
  "scripts": {
    "start": "cordova run android",
    "build": "cordova build android --release",
    "ai-proxy": "node server/ai-proxy.js",
    "test:ai-proxy": "node --test server/ai-proxy.test.js"
  },
  "keywords": [
    "cordova",
    "android",
    "budget",
    "shopping"
  ],
  "author": "SalaryWise",
  "license": "MIT",
  "devDependencies": {
    "cordova-android": "^15.1.0",
    "cordova-browser": "^7.0.0",
    "cordova-plugin-camera": "^8.0.0",
    "cordova-plugin-file": "^8.1.3",
    "cordova-plugin-file-opener2": "^4.0.0"
  },
  "cordova": {
    "plugins": {
      "cordova-plugin-camera": {
        "ANDROIDX_CORE_VERSION": "1.6.+"
      },
      "cordova-plugin-file": {
        "ANDROIDX_WEBKIT_VERSION": "1.4.0"
      },
      "cordova-plugin-file-opener2": {}
    },
    "platforms": [
      "browser"
    ]
  }
}
